# Admin login password for /admin (change this in production!)
ANTORBIT_ADMIN_PASSWORD=change-me-strong-password

# Public URL where AntOrbit is reachable (used for clickable links in push notifications)
ANTORBIT_PUBLIC_URL=https://orbit.example.com

# Optional bootstrap API Key for MCP clients (you can also generate keys in /admin)
ANTORBIT_API_KEY=
